{
  "name": "all-ok",
  "version": "0.3.4",
  "description": "Validate anything simply and type-safely",
  "keywords": [
    "validation",
    "type-safe",
    "typescript"
  ],
  "author": "oreshinya",
  "license": "MIT",
  "repository": "oreshinya/all-ok",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "docsgen": "typedoc",
    "typecheck": "tsc",
    "lint": "biome ci ./src",
    "lintfix": "biome check --write ./src",
    "test": "vitest run",
    "build": "tsdown"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
