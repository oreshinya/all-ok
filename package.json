{
  "name": "all-ok",
  "version": "0.3.4",
  "description": "Validate anything simply and type-safely",
  "keywords": [
    "validation",
    "type-safe",
    "typescript"
  ],
  "author": "oreshinya",
  "license": "MIT",
  "repository": "oreshinya/all-ok",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "docsgen": "typedoc",
    "typecheck": "tsc",
    "lint": "biome ci ./src",
    "lintfix": "biome check --write ./src",
    "test": "vitest run",
    "build": "tsdown"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
