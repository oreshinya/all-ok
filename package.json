{
  "name": "all-ok",
  "version": "0.3.4",
  "description": "Validate anything simply and type-safely",
  "keywords": [
    "validation",
    "type-safe",
    "typescript"
  ],
  "author": "oreshinya",
  "license": "MIT",
  "repository": "oreshinya/all-ok",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "docsgen": "typedoc",
    "typecheck": "tsc",
    "lint": "biome ci ./src",
    "lintfix": "biome check --write ./src",
    "test": "vitest run",
    "build": "tsdown"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
